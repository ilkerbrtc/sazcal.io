<script>
// KALIPLAR
const PATTERNS = [
  { id: 1, name: "Dörtlük", count: 1, beats: [1.0], arrows: ["↓"], doubleBeams: [] },
  { id: 2, name: "Van", count: 2, beats: [0.5, 0.5], arrows: ["↓", "↑"], doubleBeams: [] },
  { id: 3, name: "Bursa", count: 3, beats: [0.5, 0.25, 0.25], arrows: ["↓", "↓", "↑"], doubleBeams: [1, 2] },
  { id: 4, name: "Karaman", count: 3, beats: [0.25, 0.25, 0.5], arrows: ["↓", "↑", "↓"], doubleBeams: [0, 1] },
  { id: 5, name: "Gelibolu", count: 4, beats: [0.25, 0.25, 0.25, 0.25], arrows: ["↓", "↑", "↓", "↑"], doubleBeams: [0, 1, 2, 3] }
];

let selectedPatternIndex = 0;
let activeSlotIndex = 0;
let currentSlots = [];
const defaultPitch = { name: "Re", relY: 67.5, freq: 293.6, ledger: false };

let selectedGroupIdx = null;
let selectedNoteIdx = null;
let placedGroups = [];
let porteBpm = 75;

let currentTimeSignature = "4/4";
let currentKeySignature = "none";

let isPlaying = false;
let flatNotes = [];
let playIdx = 0; // Seçilen notadan başlatmak için dinamik güncellenir
let playTimer = null;
let activePlayingId = null;

let currentSongId = null;
let currentSongName = "İsimsiz Türkü";

// SES MOTORU
let audioCtx = null;
let originalAudioBuffer = null;
let currentAudioBuffer = null;
let audioElement = new Audio();
audioElement.preservesPitch = true;
let playbackRate = 1.0;

// BÜYÜTÜLMÜŞ PORTE GEOMETRİSİ
const LINE_WIDTH = 880; // Genişletildi
const LINE_HEIGHT = 165;
let startX = 150;
const MAX_X = 840;
const NOTE_SPACING = 28;
const GROUP_SPACING = 38;

function getMeasureCapacity(timeSig) {
  switch (timeSig) {
    case "2/4": return 2.0;
    case "3/4": return 3.0;
    case "4/4": return 4.0;
    case "5/8": return 2.5;
    case "6/8": return 3.0;
    case "7/8": return 3.5;
    case "9/8": return 4.5;
    case "10/8": return 5.0;
    default: return 4.0;
  }
}

// ================== EKRAN YÖNETİMİ & KÜTÜPHANE ==================
function showHomeScreen() {
  if (isPlaying) togglePlayPause();
  document.getElementById("editorScreen").style.display = "none";
  document.getElementById("homeScreen").style.display = "block";
  loadSongsLibraryUI();
}

function showEditorScreen() {
  document.getElementById("homeScreen").style.display = "none";
  document.getElementById("editorScreen").style.display = "block";
  document.getElementById("currentSongTitle").innerText = currentSongName;
  document.getElementById("timeSignatureSelect").value = currentTimeSignature;
  document.getElementById("keySignatureSelect").value = currentKeySignature;
  renderScore();
}

function getStoredSongs() {
  try {
    return JSON.parse(localStorage.getItem("baglama_songs_library")) || [];
  } catch(e) { return []; }
}

function saveStoredSongs(songs) {
  localStorage.setItem("baglama_songs_library", JSON.stringify(songs));
}

function loadSongsLibraryUI() {
  const list = document.getElementById("savedSongsList");
  const songs = getStoredSongs();
  document.getElementById("songCountBadge").innerText = `${songs.length} Eser Kayıtlı`;

  if (songs.length === 0) {
    list.innerHTML = `<div style="text-align:center; padding:20px; color:#777; font-size:13px;">
      Henüz kayıtlı bir türkü yok.<br>"Porte Oluştur" butonuna basarak ilk eserinizi yazın.
    </div>`;
    return;
  }

  list.innerHTML = "";
  songs.forEach(song => {
    const item = document.createElement("div");
    item.className = "saved-item";
    item.innerHTML = `
      <div>
        <div class="saved-title">${song.title}</div>
        <div class="saved-meta">Kalıp: ${song.groups.length} | Ölçü: ${song.timeSig || "4/4"} | BPM: ${song.bpm} | Tarih: ${song.date}</div>
      </div>
      <div style="display:flex; gap:6px;">
        <button class="btn-primary btn-small btn-play" onclick="openSong('${song.id}')">Aç / Çal ▶</button>
        <button class="btn-primary btn-small btn-danger" onclick="deleteSong('${song.id}')">🗑️ Sil</button>
      </div>
    `;
    list.appendChild(item);
  });
}

function createNewSong() {
  currentSongId = "song_" + Date.now();
  currentSongName = "Yeni Türkü " + new Date().toLocaleDateString();
  placedGroups = [];
  playIdx = 0;
  currentTimeSignature = "4/4";
  currentKeySignature = "none";
  closeEditPanel();
  removeAudioFile();
  selectPattern(0);
  addPatternWithValidation(false, true);
  showEditorScreen();
}

function openSong(id) {
  const songs = getStoredSongs();
  const found = songs.find(s => s.id === id);
  if (!found) return;

  currentSongId = found.id;
  currentSongName = found.title;
  placedGroups = JSON.parse(JSON.stringify(found.groups));
  currentTimeSignature = found.timeSig || "4/4";
  currentKeySignature = found.keySig || "none";
  setBpm(found.bpm || 75);
  playIdx = 0;
  closeEditPanel();
  removeAudioFile();
  showEditorScreen();
}

function deleteSong(id) {
  if (confirm("Bu şarkıyı kalıcı olarak silmek istediğinize emin misiniz?")) {
    let songs = getStoredSongs();
    songs = songs.filter(s => s.id !== id);
    saveStoredSongs(songs);
    loadSongsLibraryUI();
  }
}

function saveCurrentSongPrompt() {
  const newName = prompt("Şarkı adını girin:", currentSongName);
  if (!newName) return;
  currentSongName = newName;
  document.getElementById("currentSongTitle").innerText = currentSongName;

  let songs = getStoredSongs();
  const existingIndex = songs.findIndex(s => s.id === currentSongId);

  const songData = {
    id: currentSongId || ("song_" + Date.now()),
    title: currentSongName,
    bpm: porteBpm,
    timeSig: currentTimeSignature,
    keySig: currentKeySignature,
    groups: placedGroups,
    date: new Date().toLocaleDateString("tr-TR")
  };

  if (existingIndex >= 0) {
    songs[existingIndex] = songData;
  } else {
    songs.unshift(songData);
  }

  saveStoredSongs(songs);
  alert("✓ '" + currentSongName + "' başarıyla kaydedildi!");
}

function changeTimeSignature(val) {
  currentTimeSignature = val;
  renderScore();
}

function changeKeySignature(val) {
  currentKeySignature = val;
  renderScore();
}

// ================== SES VE ŞARKI YÖNETİMİ ==================
function formatSeconds(sec) {
  const m = Math.floor(sec / 60);
  const s = (sec % 60).toFixed(1);
  return `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
}

async function handleAudioUpload(event) {
  const file = event.target.files[0];
  if (!file) return;

  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  document.getElementById("audioTrackName").innerText = "Yükleniyor...";

  const arrayBuffer = await file.arrayBuffer();
  audioCtx.decodeAudioData(arrayBuffer, (decoded) => {
    originalAudioBuffer = decoded;
    currentAudioBuffer = decoded;
    applyBufferToAudioElement(decoded);

    document.getElementById("audioTrackName").innerText = `✓ ${file.name}`;
    document.getElementById("audioControlsWrap").style.display = "block";
    document.getElementById("btnRemoveSong").style.display = "inline-block";
    setupSingleTrack(decoded.duration);
  });
}

function removeAudioFile() {
  if (isPlaying && currentAudioBuffer) togglePlayPause();
  originalAudioBuffer = null;
  currentAudioBuffer = null;
  audioElement.pause();
  audioElement.src = "";
  document.getElementById("audioFileInput").value = "";
  document.getElementById("audioTrackName").innerText = "Müzik yüklenmedi";
  document.getElementById("audioControlsWrap").style.display = "none";
  document.getElementById("btnRemoveSong").style.display = "none";
  document.getElementById("audioPlayCursor").style.display = "none";
}

function setupSingleTrack(maxDur) {
  const s = document.getElementById("trimStart");
  const e = document.getElementById("trimEnd");
  s.max = maxDur;
  e.max = maxDur;
  s.value = 0;
  e.value = maxDur;
  updateSingleTrackVisuals();
}

function onTrimInput(handle, event) {
  if (event) event.stopPropagation();
  const s = document.getElementById("trimStart");
  const e = document.getElementById("trimEnd");
  let sVal = parseFloat(s.value);
  let eVal = parseFloat(e.value);

  if (handle === 'start' && sVal > eVal) s.value = eVal;
  if (handle === 'end' && eVal < sVal) e.value = sVal;

  updateSingleTrackVisuals();
}

function updateSingleTrackVisuals() {
  const s = parseFloat(document.getElementById("trimStart").value);
  const e = parseFloat(document.getElementById("trimEnd").value);
  const max = parseFloat(document.getElementById("trimStart").max) || 1;

  const leftPercent = (s / max) * 100;
  const widthPercent = Math.max(0, ((e - s) / max) * 100);

  const highlight = document.getElementById("trackHighlight");
  highlight.style.left = leftPercent + "%";
  highlight.style.width = widthPercent + "%";

  document.getElementById("startSecLabel").innerText = formatSeconds(s);
  document.getElementById("endSecLabel").innerText = formatSeconds(e);
}

function handleTrackClick(e) {
  if (!currentAudioBuffer) return;
  const rect = document.getElementById("singleTrackWrap").getBoundingClientRect();
  const clickX = e.clientX - rect.left;
  const percent = Math.max(0, Math.min(1, clickX / rect.width));
  const seekTime = percent * currentAudioBuffer.duration;

  audioElement.currentTime = seekTime;
  updatePlayCursor(percent, seekTime);
}

function seekRelative(deltaSeconds) {
  if (!currentAudioBuffer) return;
  let target = Math.max(0, Math.min(currentAudioBuffer.duration, audioElement.currentTime + deltaSeconds));
  audioElement.currentTime = target;
  const percent = target / currentAudioBuffer.duration;
  updatePlayCursor(percent, target);
}

function updatePlayCursor(percent, timeSec) {
  const cursor = document.getElementById("audioPlayCursor");
  cursor.style.display = "block";
  cursor.style.left = (percent * 100) + "%";
  document.getElementById("currentPlayPosLabel").innerText = formatSeconds(timeSec);
}

audioElement.addEventListener("timeupdate", () => {
  if (!currentAudioBuffer) return;
  const percent = audioElement.currentTime / currentAudioBuffer.duration;
  updatePlayCursor(percent, audioElement.currentTime);
});

function cropAudio() {
  if (!currentAudioBuffer) return;
  const startSec = parseFloat(document.getElementById("trimStart").value);
  const endSec = parseFloat(document.getElementById("trimEnd").value);
  if (startSec >= endSec) return alert("Seçili aralık geçersiz!");

  const rate = currentAudioBuffer.sampleRate;
  const cropped = audioCtx.createBuffer(currentAudioBuffer.numberOfChannels, Math.floor((endSec - startSec) * rate), rate);

  for (let ch = 0; ch < currentAudioBuffer.numberOfChannels; ch++) {
    cropped.copyToChannel(currentAudioBuffer.getChannelData(ch).subarray(Math.floor(startSec * rate), Math.floor(endSec * rate)), ch);
  }
  currentAudioBuffer = cropped;
  applyBufferToAudioElement(cropped);
  setupSingleTrack(cropped.duration);
  alert("✂️ Seçili aralık kırpıldı!");
}

function deleteSection() {
  if (!currentAudioBuffer) return;
  const startSec = parseFloat(document.getElementById("trimStart").value);
  const endSec = parseFloat(document.getElementById("trimEnd").value);
  if (startSec >= endSec) return alert("Silinecek aralık geçersiz!");

  const rate = currentAudioBuffer.sampleRate;
  const startSample = Math.floor(startSec * rate);
  const endSample = Math.floor(endSec * rate);
  const newLength = currentAudioBuffer.length - (endSample - startSample);
  const cutBuffer = audioCtx.createBuffer(currentAudioBuffer.numberOfChannels, newLength, rate);

  for (let ch = 0; ch < currentAudioBuffer.numberOfChannels; ch++) {
    const src = currentAudioBuffer.getChannelData(ch);
    const dest = cutBuffer.getChannelData(ch);
    dest.set(src.subarray(0, startSample), 0);
    dest.set(src.subarray(endSample), startSample);
  }
  currentAudioBuffer = cutBuffer;
  applyBufferToAudioElement(cutBuffer);
  setupSingleTrack(cutBuffer.duration);
  alert("🗑️ Seçilen aralık şarkıdan silindi!");
}

function resetToOriginalAudio() {
  if (!originalAudioBuffer) return;
  currentAudioBuffer = originalAudioBuffer;
  applyBufferToAudioElement(originalAudioBuffer);
  setupSingleTrack(originalAudioBuffer.duration);
  alert("↩️ Şarkı orijinal haline döndürüldü.");
}

function setSpeed(speed) {
  playbackRate = speed;
  audioElement.playbackRate = speed;
  document.getElementById("speedBadge").innerText = speed.toFixed(2) + "x";
}

function applyBufferToAudioElement(buf) {
  const wavBlob = bufferToWaveBlob(buf);
  audioElement.src = URL.createObjectURL(wavBlob);
  audioElement.playbackRate = playbackRate;
}

function bufferToWaveBlob(abuffer) {
  const numCh = abuffer.numberOfChannels;
  const sampleRate = abuffer.sampleRate;
  const blockAlign = numCh * 2;
  const dataLen = abuffer.length * blockAlign;
  const buffer = new ArrayBuffer(44 + dataLen);
  const view = new DataView(buffer);

  function writeStr(offset, string) {
    for (let i = 0; i < string.length; i++) view.setUint8(offset + i, string.charCodeAt(i));
  }
  writeStr(0, 'RIFF');
  view.setUint32(4, 36 + dataLen, true);
  writeStr(8, 'WAVE');
  writeStr(12, 'fmt ');
  view.setUint32(16, 16, true);
  view.setUint16(20, 1, true);
  view.setUint16(22, numCh, true);
  view.setUint32(24, sampleRate, true);
  view.setUint32(28, sampleRate * blockAlign, true);
  view.setUint16(32, blockAlign, true);
  view.setUint16(34, 16, true);
  writeStr(36, 'data');
  view.setUint32(40, dataLen, true);

  let offset = 44;
  for (let i = 0; i < abuffer.length; i++) {
    for (let ch = 0; ch < numCh; ch++) {
      let sample = Math.max(-1, Math.min(1, abuffer.getChannelData(ch)[i]));
      view.setInt16(offset, sample < 0 ? sample * 0x8000 : sample * 0x7FFF, true);
      offset += 2;
    }
  }
  return new Blob([view], { type: 'audio/wav' });
}

// ================== PORTE, KALIP VE ÖLÇÜ MOTORU ==================
function setBpm(val) {
  porteBpm = parseInt(val);
  document.getElementById("bpmSlider").value = porteBpm;
  document.getElementById("bpmBadge").innerText = porteBpm;
}

function adjustBpm(delta) {
  setBpm(Math.min(180, Math.max(40, porteBpm + delta)));
}

function selectPattern(idx) {
  selectedPatternIndex = idx;
  document.querySelectorAll(".pattern-card").forEach((c, i) => c.classList.toggle("active", i === idx));
  const p = PATTERNS[idx];
  currentSlots = Array.from({ length: p.count }, (_, i) => ({
    ...defaultPitch,
    arrow: p.arrows[i],
    durationBeat: p.beats[i]
  }));
  activeSlotIndex = 0;
  renderSlotEditor();
}

function renderSlotEditor() {
  const container = document.getElementById("slotEditor");
  container.innerHTML = "";
  currentSlots.forEach((slot, i) => {
    const box = document.createElement("div");
    box.className = "slot-box" + (i === activeSlotIndex ? " selected" : "");
    box.onclick = () => { activeSlotIndex = i; renderSlotEditor(); };
    box.innerHTML = `
      <div class="slot-num">${i + 1}. Vuruş</div>
      <div class="slot-note">${slot.name}</div>
      <div class="slot-arrow">${slot.arrow}</div>
    `;
    container.appendChild(box);
  });
}

function setSlotPitch(name, relY, freq, ledger) {
  if (currentSlots[activeSlotIndex]) {
    currentSlots[activeSlotIndex] = { ...currentSlots[activeSlotIndex], name, relY, freq, ledger };
    if (activeSlotIndex < currentSlots.length - 1) activeSlotIndex++;
    renderSlotEditor();
  }
}

// ÖLÇÜ KONTROLÜ VE EKLEME
function addPatternWithValidation(isInsertMiddle = false, silent = false) {
  const p = PATTERNS[selectedPatternIndex];
  const patternDuration = p.beats.reduce((acc, b) => acc + b, 0);
  const measureCapacity = getMeasureCapacity(currentTimeSignature);

  let insertIndex = placedGroups.length;
  if (isInsertMiddle) {
    if (selectedGroupIdx === null) {
      alert("⚠️ Araya eklemek için önce portedeki bir notaya tıklayıp konum seçmelisiniz!");
      return;
    }
    insertIndex = selectedGroupIdx + 1;
  }

  let accumulatedBeats = 0;
  for (let i = 0; i < insertIndex; i++) {
    const gDuration = placedGroups[i].notes.reduce((acc, n) => acc + n.durationBeat, 0);
    accumulatedBeats += gDuration;
  }
  const currentMeasureRemainder = accumulatedBeats % measureCapacity;

  if (!silent && currentMeasureRemainder > 0 && (currentMeasureRemainder + patternDuration) > (measureCapacity + 0.001)) {
    const remainingSpace = (measureCapacity - currentMeasureRemainder).toFixed(2);
    alert(`⚠️ Ölçü Sınırı Uyarısı:\nSeçilen ölçü (${currentTimeSignature} = ${measureCapacity} vuruş).\nMevcut ölçüde sadece ${remainingSpace} vuruşluk yer kaldı!\nEklemek istediğiniz kalıp ise ${patternDuration} vuruştur ve ölçüyü taşır.`);
    return;
  }

  const newGroup = {
    patternId: p.id,
    doubleBeams: p.doubleBeams,
    notes: JSON.parse(JSON.stringify(currentSlots))
  };

  if (isInsertMiddle) {
    placedGroups.splice(insertIndex, 0, newGroup);
    selectedGroupIdx = insertIndex;
  } else {
    placedGroups.push(newGroup);
  }

  cleanActiveMarks();
  renderScore();

  if (!isInsertMiddle) {
    setTimeout(() => {
      const scrollBox = document.getElementById("scoreScroll");
      scrollBox.scrollTop = scrollBox.scrollHeight;
    }, 50);
  }
}

function clearScore() {
  if (confirm("Portedeki notaları temizlemek istediğinize emin misiniz?")) {
    placedGroups = [];
    playIdx = 0;
    cleanActiveMarks();
    closeEditPanel();
    renderScore();
  }
}

// ================== ÖLÇÜ BÖLÜNMEZ YERLEŞİM VE BÜYÜTÜLMÜŞ PORTE ==================
function renderScore() {
  const linesGroup = document.getElementById("staffLinesGroup");
  const notesG = document.getElementById("notesGroup");
  const svg = document.getElementById("scoreSvg");
  linesGroup.innerHTML = "";
  notesG.innerHTML = "";

  // Büyütülen donanım için başlangıç payı artırıldı
  startX = (currentKeySignature !== "none") ? 165 : 140;
  const measureCapacity = getMeasureCapacity(currentTimeSignature);

  // ÖNCELİKLE KALIPLARI ÖLÇÜ GRUPLARINA AYIR (ÖLÇÜ KESİNLİKLE BÖLÜNMEZ!)
  const measures = [];
  let currentMeasure = { groups: [], totalBeats: 0, width: 0 };

  placedGroups.forEach((group, gIdx) => {
    group.originalIndex = gIdx;
    const gDuration = group.notes.reduce((acc, n) => acc + n.durationBeat, 0);
    const gWidth = (group.notes.length * NOTE_SPACING) + GROUP_SPACING;

    currentMeasure.groups.push(group);
    currentMeasure.totalBeats += gDuration;
    currentMeasure.width += gWidth;

    if (Math.abs(currentMeasure.totalBeats - measureCapacity) < 0.001 || currentMeasure.totalBeats >= measureCapacity) {
      currentMeasure.width += 20; // Barline ve boşluk payı
      measures.push(currentMeasure);
      currentMeasure = { groups: [], totalBeats: 0, width: 0 };
    }
  });

  if (currentMeasure.groups.length > 0) {
    measures.push(currentMeasure);
  }

  // ÖLÇÜLERİ SIRALARA YERLEŞTİR (ÖLÇÜ SATIRA SIĞMIYORSA BÜTÜN HALDE ALT SIRAYA GEÇER)
  let currentSystem = 0;
  let cursorX = startX;

  measures.forEach((m, mIdx) => {
    // Ölçü satır sonunu aşıyorsa ve satırın başında değilsek -> Komple alt satıra geç!
    if (cursorX + m.width > MAX_X && cursorX > startX) {
      currentSystem++;
      cursorX = startX;
    }

    m.groups.forEach((group, gInM) => {
      group.systemIndex = currentSystem;
      group.startX = cursorX;
      const gWidth = (group.notes.length * NOTE_SPACING) + GROUP_SPACING;
      cursorX += gWidth;

      group.closesMeasure = false;
      // Ölçünün son kalıbı ise barline çizilecek
      if (gInM === m.groups.length - 1 && measures.length > 0) {
        group.closesMeasure = true;
        group.measureNum = mIdx + 1;
        group.barlineX = cursorX - 10;
        cursorX += 16;
      }
    });
  });

  const totalSystems = currentSystem + 1;
  const totalSvgHeight = totalSystems * LINE_HEIGHT + 25;
  svg.setAttribute("viewBox", `0 0 ${LINE_WIDTH} ${totalSvgHeight}`);
  svg.style.height = totalSvgHeight + "px";

  // 1. Çizgiler, BÜYÜTÜLMÜŞ Sol Anahtarı, Donanım ve Ölçü Sayıları
  for (let s = 0; s < totalSystems; s++) {
    const baseY = 55 + (s * LINE_HEIGHT);
    const sysG = document.createElementNS("http://www.w3.org/2000/svg", "g");

    // 5 Çizgi (Fa, Re, Si, Sol, Mi)
    for (let l = 0; l < 5; l++) {
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      const ly = baseY + (l * 15);
      line.setAttribute("x1", "15"); line.setAttribute("y1", ly);
      line.setAttribute("x2", LINE_WIDTH - 15); line.setAttribute("y2", ly);
      line.setAttribute("stroke", "#222"); line.setAttribute("stroke-width", "1.2");
      sysG.appendChild(line);
    }

    const startBar = document.createElementNS("http://www.w3.org/2000/svg", "line");
    startBar.setAttribute("x1", "15"); startBar.setAttribute("y1", baseY);
    startBar.setAttribute("x2", "15"); startBar.setAttribute("y2", baseY + 60);
    startBar.setAttribute("stroke", "#222"); startBar.setAttribute("stroke-width", "1.5");
    sysG.appendChild(startBar);

    const endBar = document.createElementNS("http://www.w3.org/2000/svg", "line");
    endBar.setAttribute("x1", LINE_WIDTH - 15); endBar.setAttribute("y1", baseY);
    endBar.setAttribute("x2", LINE_WIDTH - 15); endBar.setAttribute("y2", baseY + 60);
    endBar.setAttribute("stroke", "#222"); endBar.setAttribute("stroke-width", "1.5");
    sysG.appendChild(endBar);

    // BÜYÜTÜLMÜŞ SOL ANAHTARI (Font-size 74)
    const clef = document.createElementNS("http://www.w3.org/2000/svg", "text");
    clef.setAttribute("x", "18"); clef.setAttribute("y", baseY + 58);
    clef.setAttribute("font-family", "serif"); clef.setAttribute("font-size", "74");
    clef.setAttribute("fill", "#111"); clef.textContent = "𝄞";
    sysG.appendChild(clef);

    // BÜYÜTÜLMÜŞ DONANIM (Arıza İşaretleri: Si♭2, Fa♯3)
    let keyX = 58;
    if (currentKeySignature.includes("sib2")) {
      const sib = document.createElementNS("http://www.w3.org/2000/svg", "text");
      sib.setAttribute("x", keyX); sib.setAttribute("y", baseY + 36);
      sib.setAttribute("font-size", "22"); sib.setAttribute("font-weight", "bold"); sib.setAttribute("fill", "#c0392b");
      sib.textContent = "♭²";
      sysG.appendChild(sib);
      keyX += 22;
    } else if (currentKeySignature.includes("sib")) {
      const sib = document.createElementNS("http://www.w3.org/2000/svg", "text");
      sib.setAttribute("x", keyX); sib.setAttribute("y", baseY + 36);
      sib.setAttribute("font-size", "24"); sib.setAttribute("fill", "#222");
      sib.textContent = "♭";
      sysG.appendChild(sib);
      keyX += 20;
    }

    if (currentKeySignature.includes("fa#3")) {
      const fas = document.createElementNS("http://www.w3.org/2000/svg", "text");
      fas.setAttribute("x", keyX); fas.setAttribute("y", baseY + 14);
      fas.setAttribute("font-size", "20"); fas.setAttribute("font-weight", "bold"); fas.setAttribute("fill", "#c0392b");
      fas.textContent = "♯³";
      sysG.appendChild(fas);
      keyX += 22;
    } else if (currentKeySignature.includes("fa#")) {
      const fas = document.createElementNS("http://www.w3.org/2000/svg", "text");
      fas.setAttribute("x", keyX); fas.setAttribute("y", baseY + 14);
      fas.setAttribute("font-size", "22"); fas.setAttribute("fill", "#222");
      fas.textContent = "♯";
      sysG.appendChild(fas);
      keyX += 20;
    }

    // BÜYÜTÜLMÜŞ ÖLÇÜ SAYISI (Font-size 28)
    const timeParts = currentTimeSignature.split("/");
    const timeX = keyX + 12;
    const numTop = document.createElementNS("http://www.w3.org/2000/svg", "text");
    numTop.setAttribute("x", timeX); numTop.setAttribute("y", baseY + 26);
    numTop.setAttribute("font-size", "28"); numTop.setAttribute("font-weight", "bold");
    numTop.setAttribute("text-anchor", "middle"); numTop.setAttribute("fill", "#111");
    numTop.textContent = timeParts[0];
    sysG.appendChild(numTop);

    const numBot = document.createElementNS("http://www.w3.org/2000/svg", "text");
    numBot.setAttribute("x", timeX); numBot.setAttribute("y", baseY + 56);
    numBot.setAttribute("font-size", "28"); numBot.setAttribute("font-weight", "bold");
    numBot.setAttribute("text-anchor", "middle"); numBot.setAttribute("fill", "#111");
    numBot.textContent = timeParts[1];
    sysG.appendChild(numBot);

    linesGroup.appendChild(sysG);
  }

  // 2. Notalar ve Ölçü Çizgileri
  placedGroups.forEach((group, gIdx) => {
    const s = group.systemIndex;
    const baseY = 55 + (s * LINE_HEIGHT);
    const groupG = document.createElementNS("http://www.w3.org/2000/svg", "g");

    const noteAbsY = group.notes.map(n => baseY + n.relY);
    const minY = Math.min(...noteAbsY);
    const stemTop = minY - 26;
    const notePositions = [];

    group.notes.forEach((note, nIdx) => {
      const nx = group.startX + (nIdx * NOTE_SPACING);
      const ny = baseY + note.relY;
      note.renderX = nx; note.renderY = ny; note.systemIndex = s;
      notePositions.push({ x: nx, y: ny });

      const noteDomId = `note_el_${gIdx}_${nIdx}`;
      note.domId = noteDomId;
      note.gIdx = gIdx;
      note.nIdx = nIdx;

      // AYAR İÇİN SEÇİLİ NOTA (TURUNCU)
      const isSelected = (selectedGroupIdx === gIdx && selectedNoteIdx === nIdx);
      // ÇALAN NOTA (KIRMIZI)
      const isCurrentActive = (activePlayingId === noteDomId);

      const noteItemG = document.createElementNS("http://www.w3.org/2000/svg", "g");
      noteItemG.setAttribute("id", noteDomId);
      noteItemG.style.cursor = "pointer";

      if (isCurrentActive) {
        noteItemG.classList.add("active-red-note");
      } else if (isSelected) {
        noteItemG.classList.add("selected-orange-note");
      }

      noteItemG.onclick = (e) => { e.stopPropagation(); selectPlacedNote(gIdx, nIdx); };

      const hitBox = document.createElementNS("http://www.w3.org/2000/svg", "rect");
      hitBox.setAttribute("x", nx - 12); hitBox.setAttribute("y", stemTop - 6);
      hitBox.setAttribute("width", "24"); hitBox.setAttribute("height", (ny - stemTop) + 36);
      hitBox.setAttribute("fill", "transparent");
      noteItemG.appendChild(hitBox);

      // Parlama Aurası
      const glow = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      glow.setAttribute("class", "note-glow");
      glow.setAttribute("cx", nx); glow.setAttribute("cy", ny); glow.setAttribute("r", "12");
      glow.style.display = (isSelected || isCurrentActive) ? "block" : "none";
      noteItemG.appendChild(glow);

      if (note.ledger) {
        const led = document.createElementNS("http://www.w3.org/2000/svg", "line");
        led.setAttribute("x1", nx - 10); led.setAttribute("y1", ny);
        led.setAttribute("x2", nx + 10); led.setAttribute("y2", ny);
        led.setAttribute("stroke", "#222"); led.setAttribute("stroke-width", "1.4");
        noteItemG.appendChild(led);
      }

      const head = document.createElementNS("http://www.w3.org/2000/svg", "ellipse");
      head.setAttribute("class", "note-head");
      head.setAttribute("cx", nx); head.setAttribute("cy", ny);
      head.setAttribute("rx", "5.8"); head.setAttribute("ry", "4.3");
      head.setAttribute("fill", "#111");
      head.setAttribute("transform", `rotate(-25 ${nx} ${ny})`);
      noteItemG.appendChild(head);

      const stem = document.createElementNS("http://www.w3.org/2000/svg", "line");
      stem.setAttribute("class", "note-stem");
      const stemX = nx + 5;
      const targetTop = (group.notes.length === 1) ? (ny - 26) : stemTop;
      stem.setAttribute("x1", stemX); stem.setAttribute("y1", ny - 1);
      stem.setAttribute("x2", stemX); stem.setAttribute("y2", targetTop);
      stem.setAttribute("stroke", "#111");
      stem.setAttribute("stroke-width", "1.6");
      noteItemG.appendChild(stem);

      const arr = document.createElementNS("http://www.w3.org/2000/svg", "text");
      arr.setAttribute("class", "note-arrow");
      arr.setAttribute("x", nx); arr.setAttribute("y", baseY + 86);
      arr.setAttribute("font-size", "15"); arr.setAttribute("font-weight", "bold");
      arr.setAttribute("text-anchor", "middle");
      arr.setAttribute("fill", "#ff4d6d");
      arr.textContent = note.arrow;
      noteItemG.appendChild(arr);

      const lbl = document.createElementNS("http://www.w3.org/2000/svg", "text");
      lbl.setAttribute("class", "note-label");
      lbl.setAttribute("x", nx); lbl.setAttribute("y", baseY + 102);
      lbl.setAttribute("font-size", "10"); lbl.setAttribute("text-anchor", "middle");
      lbl.setAttribute("fill", "#666");
      lbl.textContent = note.name;
      noteItemG.appendChild(lbl);

      groupG.appendChild(noteItemG);
    });

    if (group.notes.length > 1) {
      const firstX = notePositions[0].x + 5;
      const lastX = notePositions[notePositions.length - 1].x + 5;

      const beam1 = document.createElementNS("http://www.w3.org/2000/svg", "line");
      beam1.setAttribute("x1", firstX); beam1.setAttribute("y1", stemTop);
      beam1.setAttribute("x2", lastX); beam1.setAttribute("y2", stemTop);
      beam1.setAttribute("stroke", "#111"); beam1.setAttribute("stroke-width", "3.2");
      groupG.appendChild(beam1);

      if (group.doubleBeams.length > 1) {
        const startSubX = notePositions[group.doubleBeams[0]].x + 5;
        const endSubX = notePositions[group.doubleBeams[group.doubleBeams.length - 1]].x + 5;
        const beam2 = document.createElementNS("http://www.w3.org/2000/svg", "line");
        beam2.setAttribute("x1", startSubX); beam2.setAttribute("y1", stemTop + 5);
        beam2.setAttribute("x2", endSubX); beam2.setAttribute("y2", stemTop + 5);
        beam2.setAttribute("stroke", "#111"); beam2.setAttribute("stroke-width", "2.8");
        groupG.appendChild(beam2);
      }
    }

    // ÖLÇÜ ÇİZGİSİ
    if (group.closesMeasure) {
      const barline = document.createElementNS("http://www.w3.org/2000/svg", "line");
      barline.setAttribute("x1", group.barlineX); barline.setAttribute("y1", baseY);
      barline.setAttribute("x2", group.barlineX); barline.setAttribute("y2", baseY + 60);
      barline.setAttribute("stroke", "#111"); barline.setAttribute("stroke-width", "1.6");
      groupG.appendChild(barline);

      const mNum = document.createElementNS("http://www.w3.org/2000/svg", "text");
      mNum.setAttribute("x", group.barlineX); mNum.setAttribute("y", baseY - 4);
      mNum.setAttribute("font-size", "10"); mNum.setAttribute("font-weight", "bold");
      mNum.setAttribute("fill", "#888"); mNum.setAttribute("text-anchor", "middle");
      mNum.textContent = group.measureNum;
      groupG.appendChild(mNum);
    }

    notesG.appendChild(groupG);
  });
}

// TEMİZLEME YARDIMCISI
function cleanActiveMarks() {
  document.querySelectorAll('.active-red-note').forEach(el => el.classList.remove('active-red-note'));
  document.querySelectorAll('.selected-orange-note').forEach(el => el.classList.remove('selected-orange-note'));
  document.querySelectorAll('.note-glow').forEach(el => el.style.display = 'none');
  activePlayingId = null;
}

// ================== NOTA SEÇİMİ (TURUNCU) & ORADAN BAŞLATMA ==================
function selectPlacedNote(gIdx, nIdx) {
  selectedGroupIdx = gIdx;
  selectedNoteIdx = nIdx;
  const note = placedGroups[gIdx].notes[nIdx];
  playSynth(note.freq, 0.2);

  // Araya ekle butonunun metnini güncelle
  const insertBtn = document.getElementById("btnInsertMiddle");
  insertBtn.innerText = `➕ ${note.name} Notasının Yanına Ekle`;

  const panel = document.getElementById("editPanel");
  panel.style.display = "block";
  document.getElementById("editLabel").innerText = `🎯 Ayar İçin Seçildi: ${note.name} (${note.arrow}) [Başlat'a basınca buradan çalar]`;

  // ÇALMA SIRASINI TAM BU NOTAYA HİZALA (ORADAN BAŞLASIN DİYE)
  let targetFlatIndex = 0;
  for (let g = 0; g < gIdx; g++) {
    targetFlatIndex += placedGroups[g].notes.length;
  }
  targetFlatIndex += nIdx;
  playIdx = targetFlatIndex;

  // Başlat butonunu bilgilendirici yap
  if (!isPlaying) {
    document.getElementById("btnPlayPause").innerText = `Bu Notadan Başlat ▶`;
  }

  cleanActiveMarks();
  renderScore();
}

function updateSelectedNote(name, relY, freq, ledger) {
  if (selectedGroupIdx === null || selectedNoteIdx === null) return;
  const target = placedGroups[selectedGroupIdx].notes[selectedNoteIdx];
  target.name = name; target.relY = relY; target.freq = freq; target.ledger = ledger;
  playSynth(freq, 0.2);
  cleanActiveMarks();
  renderScore();
}

function toggleSelectedNoteArrow() {
  if (selectedGroupIdx === null || selectedNoteIdx === null) return;
  const target = placedGroups[selectedGroupIdx].notes[selectedNoteIdx];
  target.arrow = target.arrow === "↓" ? "↑" : "↓";
  renderScore();
}

function deleteSelectedGroup() {
  if (selectedGroupIdx === null) return;
  placedGroups.splice(selectedGroupIdx, 1);
  closeEditPanel();
  cleanActiveMarks();
  renderScore();
}

function closeEditPanel() {
  selectedGroupIdx = null; selectedNoteIdx = null;
  document.getElementById("btnInsertMiddle").innerText = "➕ Araya Ekle (Seçilenden Sonra)";
  document.getElementById("editPanel").style.display = "none";
  if (!isPlaying) document.getElementById("btnPlayPause").innerText = "Başlat ▶";
  cleanActiveMarks();
  renderScore();
}

// ================== GELİŞMİŞ ÇALMA MOTORU ==================
function playSynth(freq, dur) {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = "triangle";
  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
  gain.gain.setValueAtTime(0.35, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + dur);
}

function stepPlay() {
  if (!isPlaying || flatNotes.length === 0) return;

  if (playIdx >= flatNotes.length) {
    playIdx = 0; // Başa sar
  }

  cleanActiveMarks();

  const note = flatNotes[playIdx];
  const beatSec = (60 / porteBpm) / playbackRate;
  const duration = note.durationBeat * beatSec;

  // ÇALMA SIRASINDA KIRMIZI OLUR
  activePlayingId = note.domId;
  const currentEl = document.getElementById(note.domId);
  if (currentEl) currentEl.classList.add("active-red-note");

  // Ekranı satır değiştikçe yumuşakça kaydır
  const scrollBox = document.getElementById("scoreScroll");
  const targetScrollY = note.systemIndex * LINE_HEIGHT;
  if (scrollBox.scrollTop !== targetScrollY) {
    scrollBox.scrollTop = targetScrollY;
  }

  if (!currentAudioBuffer) {
    playSynth(note.freq, duration * 0.9);
  }

  playIdx++;
  playTimer = setTimeout(stepPlay, duration * 1000);
}

// OYNAT / DURAKLAT (TURUNCU NOTADAN BAŞLAR VEYA KALDIĞI YERDEN DEVAM EDER)
function togglePlayPause() {
  const btn = document.getElementById("btnPlayPause");
  isPlaying = !isPlaying;

  if (isPlaying) {
    flatNotes = [];
    placedGroups.forEach(g => g.notes.forEach(n => flatNotes.push(n)));

    if (flatNotes.length === 0) {
      alert("Lütfen porteye en az bir nota kalıbı ekleyin!");
      isPlaying = false;
      return;
    }

    if (playIdx >= flatNotes.length) playIdx = 0;

    btn.innerText = "Duraklat ⏸";
    btn.className = "btn-primary btn-pause";

    if (currentAudioBuffer) {
      audioElement.play();
    }
    stepPlay();
  } else {
    // DURAKLATILDI: Kırmızı işaret durduğu notada sabit kalır
    btn.innerText = "Devam Et ▶";
    btn.className = "btn-primary btn-play";
    clearTimeout(playTimer);

    if (currentAudioBuffer) {
      audioElement.pause();
    }
  }
}

function rewindToStart() {
  playIdx = 0;
  if (currentAudioBuffer) {
    audioElement.currentTime = 0;
    updatePlayCursor(0, 0);
  }

  cleanActiveMarks();

  flatNotes = [];
  placedGroups.forEach(g => g.notes.forEach(n => flatNotes.push(n)));

  if (flatNotes.length > 0) {
    activePlayingId = flatNotes[0].domId;
    const firstEl = document.getElementById(activePlayingId);
    if (firstEl) firstEl.classList.add("active-red-note");
  }

  document.getElementById("scoreScroll").scrollTop = 0;

  if (!isPlaying) {
    document.getElementById("btnPlayPause").innerText = "Başlat ▶";
    document.getElementById("btnPlayPause").className = "btn-primary btn-play";
  }
}

// UYGULAMA İLK BAŞLATMA
showHomeScreen();
</script>
