<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Bağlama Nota ve Eğitim Stüdyosu</title>
<style>
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: #14151b;
    color: #e4e6eb;
    margin: 0;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .app-card {
    width: 100%;
    max-width: 940px; /* Porte büyütüldü */
    background: #1f202b;
    border-radius: 14px;
    padding: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.6);
  }
  h2 { margin: 0 0 4px 0; color: #ffb703; font-size: 20px; }
  p { margin: 0 0 14px 0; font-size: 13px; color: #9aa0a6; }

  /* ================== 1. ANA EKRAN ================== */
  #homeScreen { display: block; }
  .folder-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 10px;
  }
  @media(min-width: 600px) {
    .folder-grid { grid-template-columns: 1fr 1fr; }
  }
  .folder-card {
    background: #282a3a;
    border: 2px solid #3d4157;
    border-radius: 12px;
    padding: 18px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .folder-card:hover {
    border-color: #ffb703;
    transform: translateY(-2px);
    background: #2e3044;
  }
  .folder-header {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: bold;
    color: #ffb703;
  }
  .folder-desc { font-size: 12px; color: #a5a9c2; margin-top: 6px; }

  .saved-list-box {
    margin-top: 14px;
    max-height: 320px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .saved-item {
    background: #1c1d27;
    border: 1px solid #383a50;
    border-radius: 8px;
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .saved-title { font-weight: bold; font-size: 14px; color: #fff; }
  .saved-meta { font-size: 11px; color: #8e92ab; margin-top: 2px; }

  /* ================== 2. EDİTÖR EKRANI ================== */
  #editorScreen { display: none; }
  .top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid #333649;
  }

  .score-settings-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    background: #272838;
    padding: 8px 12px;
    border-radius: 8px;
    margin-bottom: 10px;
    align-items: center;
    font-size: 12px;
  }
  .score-settings-bar select {
    background: #191a24;
    color: #ffb703;
    border: 1px solid #474b66;
    padding: 5px 9px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 12px;
    cursor: pointer;
  }

  /* BÜYÜTÜLMÜŞ ÇOK SATIRLI PORTE */
  .score-scroll {
    position: relative;
    width: 100%;
    max-height: 400px;
    background: #ffffff;
    border-radius: 8px;
    overflow-y: auto;
    overflow-x: hidden;
    border: 1px solid #c8c8c8;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.06);
    scroll-behavior: smooth;
  }
  #scoreSvg { display: block; width: 100%; }

  /* AYAR İÇİN SEÇİLEN NOTA (TURUNCU) */
  .selected-orange-note .note-head { fill: #f77f00 !important; }
  .selected-orange-note .note-stem { stroke: #f77f00 !important; stroke-width: 2.2 !important; }
  .selected-orange-note .note-arrow { fill: #f77f00 !important; font-size: 18px !important; }
  .selected-orange-note .note-label { fill: #f77f00 !important; font-weight: bold !important; }
  .selected-orange-note .note-glow {
    display: block !important;
    fill: rgba(247, 127, 0, 0.3) !important;
    stroke: #f77f00 !important;
  }

  /* ÇALAN NOTA (KIRMIZI) */
  .active-red-note .note-head { fill: #e63946 !important; }
  .active-red-note .note-stem { stroke: #e63946 !important; stroke-width: 2.2 !important; }
  .active-red-note .note-arrow { fill: #e63946 !important; font-size: 18px !important; }
  .active-red-note .note-label { fill: #e63946 !important; font-weight: bold !important; }
  .active-red-note .note-glow {
    display: block !important;
    fill: rgba(230, 57, 70, 0.3) !important;
    stroke: #e63946 !important;
  }

  /* TEK ÇİZGİ ÇUBUK */
  .single-track-container {
    position: relative;
    width: 100%;
    height: 42px;
    background: #12131a;
    border: 1px solid #3d4157;
    border-radius: 8px;
    margin: 10px 0 6px 0;
    overflow: hidden;
    cursor: pointer;
  }
  .track-highlight {
    position: absolute;
    top: 0; bottom: 0;
    background: rgba(255, 183, 3, 0.28);
    border-left: 3px solid #2ec4b6;
    border-right: 3px solid #e63946;
    pointer-events: none;
    z-index: 1;
  }
  .track-audio-progress {
    position: absolute;
    top: 0; bottom: 0;
    width: 3.5px;
    background: #ffffff;
    box-shadow: 0 0 10px #ffffff;
    pointer-events: none;
    z-index: 4;
    display: none;
  }
  .track-audio-progress::after {
    content: "▼";
    position: absolute;
    top: -2px; left: -4px;
    font-size: 10px; color: #fff;
  }
  .single-track-container input[type="range"] {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    -webkit-appearance: none;
    background: transparent;
    pointer-events: none;
    margin: 0;
    z-index: 2;
  }
  .single-track-container input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    pointer-events: auto;
    width: 16px; height: 42px;
    border-radius: 4px;
    cursor: ew-resize;
    box-shadow: 0 0 6px rgba(0,0,0,0.6);
  }
  #trimStart::-webkit-slider-thumb { background: #2ec4b6; border: 1.5px solid #fff; }
  #trimEnd::-webkit-slider-thumb { background: #e63946; border: 1.5px solid #fff; }

  .track-time-labels {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #a5a9c2;
    margin-bottom: 8px;
    font-family: monospace;
  }

  .playback-bar {
    background: #272838;
    border: 1px solid #ffb703;
    border-radius: 8px;
    padding: 10px;
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .play-controls { display: flex; align-items: center; gap: 8px; }

  .btn-step {
    background: #3b3e54;
    border: 1px solid #555a7d;
    color: #fff;
    width: 28px; height: 28px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: bold;
    cursor: pointer;
  }

  .studio-box {
    background: #272838;
    border: 1px solid #3d4059;
    border-radius: 10px;
    padding: 12px;
    margin-top: 12px;
  }
  .badge {
    background: #393c54;
    padding: 3px 8px;
    border-radius: 4px;
    font-family: monospace;
    font-size: 11px;
    color: #fff;
  }

  /* AYAR PANELİ (TURUNCU ÇERÇEVELİ) */
  .edit-panel {
    display: none;
    background: #2e3042;
    border: 2px solid #f77f00; /* Turuncu çerçeve */
    border-radius: 8px;
    padding: 10px;
    margin-top: 10px;
  }
  .edit-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: bold;
    color: #f77f00;
    margin-bottom: 8px;
  }

  .section-title {
    font-size: 12px;
    font-weight: bold;
    color: #ffb703;
    margin: 12px 0 6px 0;
    text-transform: uppercase;
  }
  .pattern-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 6px;
  }
  .pattern-card {
    background: #2a2c3d;
    border: 2px solid #3d4157;
    border-radius: 8px;
    padding: 6px;
    text-align: center;
    cursor: pointer;
  }
  .pattern-card.active { border-color: #ffb703; background: #373952; }
  .pattern-title { font-size: 11px; font-weight: bold; }
  .pattern-arrows { color: #ff4d6d; font-size: 13px; font-weight: bold; }

  .slot-editor {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    background: #181924;
    padding: 8px;
    border-radius: 8px;
    margin-top: 6px;
  }
  .slot-box {
    background: #34374d;
    border: 2px solid #4a4f6e;
    border-radius: 6px;
    padding: 4px 8px;
    cursor: pointer;
    text-align: center;
  }
  .slot-box.selected { border-color: #ffb703; background: #454969; }
  .slot-num { font-size: 9px; color: #a5a9c2; }
  .slot-note { font-size: 12px; font-weight: bold; }
  .slot-arrow { font-size: 10px; color: #ff4d6d; font-weight: bold; }

  .pitch-category {
    font-size: 11px;
    color: #a5a9c2;
    margin: 6px 0 2px 0;
    font-weight: 600;
  }
  .pitch-palette { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 6px; }
  .btn-pitch {
    background: #2e3144;
    color: #fff;
    border: 1px solid #474b66;
    padding: 5px 8px;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
  }
  .btn-pitch:active { background: #ffb703; color: #000; }
  .btn-pitch.koma { border-color: #f77f00; color: #f77f00; }
  .btn-pitch.ince { border-color: #2ec4b6; color: #2ec4b6; }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    align-items: center;
  }
  .btn-primary {
    background: #ffb703;
    color: #111;
    border: none;
    padding: 9px 14px;
    border-radius: 7px;
    font-weight: bold;
    font-size: 12px;
    cursor: pointer;
  }
  .btn-play { background: #2ec4b6; color: #000; font-size: 13px; }
  .btn-pause { background: #e67e22; color: #fff; font-size: 13px; }
  .btn-rewind { background: #3d4157; color: #fff; font-size: 13px; }
  .btn-insert { background: #9b5de5; color: #fff; }
  .btn-danger { background: #49282b; border: 1px solid #753338; color: #ff858d; }
  .btn-action { background: #3c4059; color: #fff; border: 1px solid #555a7d; }
  .btn-small { padding: 5px 10px; font-size: 11px; border-radius: 5px; }
</style>
</head>
<body>

<div class="app-card">

  <!-- ======================= 1. ANA EKRAN ======================= -->
  <div id="homeScreen">
    <h2>Bağlama Nota ve Eğitim Stüdyosu</h2>
    <p>Kaydettiğiniz eserleri yönetin veya sıfırdan yeni bir porte oluşturun.</p>

    <div class="folder-grid">
      <div class="folder-card" onclick="createNewSong()">
        <div>
          <div class="folder-header">🎼 Porte Oluştur</div>
          <div class="folder-desc">Genişletilmiş temiz bir porte açarak bağlama tezene kalıplarıyla yeni bir türkü yazın.</div>
        </div>
        <div style="margin-top: 15px;">
          <button class="btn-primary" style="width:100%;">Yeni Eser Başlat +</button>
        </div>
      </div>

      <div class="folder-card" style="cursor:default;">
        <div>
          <div class="folder-header">📁 Kaydedilen Şarkılar</div>
          <div class="folder-desc">Kayıtlı türkülerinizi görüntüleyin, açıp çalın veya silin.</div>
        </div>
        <div style="margin-top: 15px;">
          <span class="badge" id="songCountBadge">0 Eser Kayıtlı</span>
        </div>
      </div>
    </div>

    <div style="margin-top: 20px;">
      <div style="font-size: 13px; font-weight: bold; color: #ffb703; margin-bottom: 8px;">📚 Eser Kütüphanem:</div>
      <div id="savedSongsList" class="saved-list-box"></div>
    </div>
  </div>


  <!-- ======================= 2. EDİTÖR EKRANI ======================= -->
  <div id="editorScreen">
    <div class="top-nav">
      <button class="btn-primary btn-action btn-small" onclick="showHomeScreen()">⬅ Ana Ekrana Dön</button>
      <span id="currentSongTitle" style="font-weight:bold; font-size:15px; color:#ffb703;">İsimsiz Türkü</span>
      <button class="btn-primary btn-small" onclick="saveCurrentSongPrompt()">💾 Şarkıyı Kaydet</button>
    </div>

    <!-- ÖLÇÜ VE DONANIM AYARLARI -->
    <div class="score-settings-bar">
      <div>
        <span>Ölçü Sayısı:</span>
        <select id="timeSignatureSelect" onchange="changeTimeSignature(this.value)">
          <option value="4/4" selected>4/4 (Dört Dörtlük)</option>
          <option value="2/4">2/4</option>
          <option value="3/4">3/4</option>
          <option value="5/8">5/8</option>
          <option value="6/8">6/8</option>
          <option value="7/8">7/8</option>
          <option value="9/8">9/8</option>
          <option value="10/8">10/8</option>
        </select>
      </div>

      <div>
        <span>Donanım (Makam / Arıza):</span>
        <select id="keySignatureSelect" onchange="changeKeySignature(this.value)">
          <option value="none" selected>Doğal (Arızasız)</option>
          <option value="sib2">Si♭2 (Hüseyni / Uşşak)</option>
          <option value="sib">Si♭ (Standart Bemol)</option>
          <option value="fa#3">Fa♯3 (Koma Diyez)</option>
          <option value="fa#">Fa♯ (Standart Diyez)</option>
          <option value="sib2_fa#3">Si♭2 + Fa♯3</option>
        </select>
      </div>
    </div>

    <!-- BÜYÜTÜLMÜŞ PORTE ALANI -->
    <div class="score-scroll" id="scoreScroll">
      <svg id="scoreSvg" viewBox="0 0 880 180">
        <g id="staffLinesGroup"></g>
        <g id="notesGroup"></g>
      </svg>
    </div>

    <!-- OYNATMA BAR (SEÇİLEN NOTADAN DEVAM EDER) -->
    <div class="playback-bar">
      <div class="play-controls">
        <button id="btnPlayPause" class="btn-primary btn-play" onclick="togglePlayPause()">Başlat ▶</button>
        <button class="btn-primary btn-rewind" onclick="rewindToStart()">⏮ Başa Al</button>
      </div>

      <div style="display:flex; align-items:center; gap:6px;">
        <span style="font-size:12px; font-weight:bold; color:#ffb703;">⏱️ Hız (BPM):</span>
        <button class="btn-step" onclick="adjustBpm(-1)">-</button>
        <span class="badge" id="bpmBadge" style="font-size:13px; font-weight:bold;">75</span>
        <button class="btn-step" onclick="adjustBpm(+1)">+</button>
        <input type="range" id="bpmSlider" min="40" max="180" value="75" oninput="setBpm(this.value)" style="width:90px;">
      </div>
    </div>

    <!-- SEÇİLİ NOTAYI DÜZELTME PANELİ (TURUNCU) -->
    <div id="editPanel" class="edit-panel">
      <div class="edit-header">
        <span id="editLabel">🎯 Seçili Nota: Re (↓) [Buradan Başlatılabilir]</span>
        <div>
          <button class="btn-primary btn-small" onclick="toggleSelectedNoteArrow()">Vuruş (↓ / ↑)</button>
          <button class="btn-primary btn-danger btn-small" onclick="deleteSelectedGroup()">Bu Kalıbı Sil ✕</button>
          <button class="btn-primary btn-small btn-action" onclick="closeEditPanel()">Kapat</button>
        </div>
      </div>
      <div style="display:flex; flex-wrap:wrap; gap:5px;">
        <button class="btn-pitch" onclick="updateSelectedNote('Do', 75, 261.6, true)">Do</button>
        <button class="btn-pitch" onclick="updateSelectedNote('Re', 67.5, 293.6, false)">Re</button>
        <button class="btn-pitch" onclick="updateSelectedNote('Mi', 60, 329.6, false)">Mi</button>
        <button class="btn-pitch" onclick="updateSelectedNote('Fa', 52.5, 349.2, false)">Fa</button>
        <button class="btn-pitch koma" onclick="updateSelectedNote('Fa#3', 52.5, 370.0, false)">Fa♯3</button>
        <button class="btn-pitch" onclick="updateSelectedNote('Sol', 45, 392.0, false)">Sol</button>
        <button class="btn-pitch" onclick="updateSelectedNote('La', 37.5, 440.0, false)">La</button>
        <button class="btn-pitch" onclick="updateSelectedNote('Si', 30, 493.8, false)">Si</button>
        <button class="btn-pitch koma" onclick="updateSelectedNote('Sib2', 30, 466.1, false)">Si♭2</button>
        <button class="btn-pitch ince" onclick="updateSelectedNote('Do', 22.5, 523.2, false)">Do</button>
        <button class="btn-pitch ince" onclick="updateSelectedNote('Re', 15, 587.3, false)">Re</button>
        <button class="btn-pitch ince" onclick="updateSelectedNote('Mi', 7.5, 659.2, false)">Mi</button>
        <button class="btn-pitch ince" onclick="updateSelectedNote('Fa', 0, 698.4, false)">Fa</button>
        <button class="btn-pitch ince" onclick="updateSelectedNote('Sol', -7.5, 783.9, false)">Sol</button>
        <button class="btn-pitch ince" onclick="updateSelectedNote('La', -15, 880.0, true)">La</button>
      </div>
    </div>

    <!-- ŞARKI PANELİ -->
    <div class="studio-box">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <span style="font-size:12px; font-weight:bold; color:#ffb703;">🎵 Harici Şarkı ve Ses Stüdyosu</span>
        <span id="audioTrackName" style="font-size:11px; color:#2ec4b6;">Müzik yüklenmedi</span>
      </div>

      <div style="display:flex; gap:8px; align-items:center;">
        <input type="file" id="audioFileInput" accept="audio/*" style="display:none;" onchange="handleAudioUpload(event)">
        <button class="btn-primary btn-action btn-small" onclick="document.getElementById('audioFileInput').click()">📁 Cihazdan Şarkı Seç</button>
        <button id="btnRemoveSong" class="btn-primary btn-danger btn-small" style="display:none;" onclick="removeAudioFile()">🗑️ Şarkıyı Kaldır</button>
      </div>

      <div id="audioControlsWrap" style="display:none; margin-top:10px;">
        <div style="display:flex; align-items:center; flex-wrap:wrap; gap:5px; margin-bottom:8px; font-size:12px;">
          <span>Şarkı Hızı:</span>
          <button class="btn-primary btn-small btn-action" onclick="setSpeed(0.5)">0.5x</button>
          <button class="btn-primary btn-small btn-action" onclick="setSpeed(0.75)">0.75x</button>
          <button class="btn-primary btn-small btn-action" onclick="setSpeed(1.0)">1.0x</button>
          <button class="btn-primary btn-small btn-action" onclick="setSpeed(1.25)">1.25x</button>
          <button class="btn-primary btn-small btn-action" onclick="setSpeed(1.5)">1.5x</button>
          <button class="btn-primary btn-small btn-action" onclick="setSpeed(2.0)">2.0x</button>
          <span class="badge" id="speedBadge">1.00x</span>

          <div style="margin-left:auto; display:flex; gap:4px;">
            <button class="btn-primary btn-small btn-action" onclick="seekRelative(-5)">-5s ⏪</button>
            <button class="btn-primary btn-small btn-action" onclick="seekRelative(+5)">⏩ +5s</button>
          </div>
        </div>

        <div class="single-track-container" id="singleTrackWrap" onclick="handleTrackClick(event)">
          <div class="track-highlight" id="trackHighlight"></div>
          <div class="track-audio-progress" id="audioPlayCursor"></div>
          <input type="range" id="trimStart" min="0" max="100" step="0.1" value="0" oninput="onTrimInput('start', event)">
          <input type="range" id="trimEnd" min="0" max="100" step="0.1" value="100" oninput="onTrimInput('end', event)">
        </div>

        <div class="track-time-labels">
          <span>🟢 Başlangıç (A): <b id="startSecLabel">00:00.0</b></span>
          <span>Konum: <b id="currentPlayPosLabel" style="color:#ffffff;">00:00.0</b></span>
          <span>🔴 Bitiş (B): <b id="endSecLabel">00:00.0</b></span>
        </div>

        <div style="display:flex; flex-wrap:wrap; gap:6px;">
          <button class="btn-primary btn-small" onclick="cropAudio()">✂️ Seçili Aralığı Kırp</button>
          <button class="btn-primary btn-small btn-danger" onclick="deleteSection()">🗑️ Seçili Aralığı Sil</button>
          <button class="btn-primary btn-small btn-action" onclick="resetToOriginalAudio()">↩️ Orijinale Dön</button>
        </div>
      </div>
    </div>

    <!-- KALIP SEÇİMİ -->
    <div class="section-title">1. Tezene Kalıbı Seçin:</div>
    <div class="pattern-grid">
      <div class="pattern-card active" onclick="selectPattern(0)">
        <div class="pattern-title">Kalıp 1 (Dörtlük)</div>
        <div class="pattern-arrows">↓</div>
      </div>
      <div class="pattern-card" onclick="selectPattern(1)">
        <div class="pattern-title">Kalıp 2 (Van)</div>
        <div class="pattern-arrows">↓ ↑</div>
      </div>
      <div class="pattern-card" onclick="selectPattern(2)">
        <div class="pattern-title">Kalıp 3 (Bursa)</div>
        <div class="pattern-arrows">↓ ↓ ↑</div>
      </div>
      <div class="pattern-card" onclick="selectPattern(3)">
        <div class="pattern-title">Kalıp 4 (Karaman)</div>
        <div class="pattern-arrows">↓ ↑ ↓</div>
      </div>
      <div class="pattern-card" onclick="selectPattern(4)">
        <div class="pattern-title">Kalıp 5 (Gelibolu)</div>
        <div class="pattern-arrows">↓ ↑ ↓ ↑</div>
      </div>
    </div>

    <!-- KALIP İÇİ NOTA ATAMA -->
    <div class="section-title">2. Kalıbın Notalarını Belirleyin:</div>
    <div class="slot-editor" id="slotEditor"></div>

    <div class="pitch-category">Normal:</div>
    <div class="pitch-palette">
      <button class="btn-pitch" onclick="setSlotPitch('Do', 75, 261.6, true)">Do</button>
